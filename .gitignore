# --- Entornos virtuales ---
venv/
.venv/
env/
ENV/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- DuckDB / datos pesados ---
*.duckdb
*.duckdb.wal
*.duckdb.tmp/
data/warehouse.duckdb
data/raw/*.parquet
data/raw/.staging/

# --- Outputs de análisis (regenerables) ---
analysis/outputs/
!analysis/outputs/.gitkeep

# --- Notebooks ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- dbt ---
dbt_project/target/
dbt_project/dbt_packages/
dbt_project/logs/
logs/
.user.yml

# El informe HTML final SÍ se versiona: es el entregable del portfolio.
# La regla `dist/` de más arriba es para artefactos de build de Python y se
# tragaba report/dist/, que es justo lo contrario de lo que se quiere.
!report/dist/
!report/dist/**

# --- Astro CLI / Airflow local ---
# airflow_settings.yaml sí se versiona: no lleva secretos (ver el propio fichero).
.astro/standalone/
.astro/worktrees/
.astro/*.local.yml
.astro/*.local.yaml
**/.astro/dbt_metadata.json
**/.astro/manifest.slim.json
airflow-webserver.pid
webserver_config.py
airflow.cfg
airflow.db

# --- Sistema / editores ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# --- Secretos ---
.env
.env.*
!.env.example

